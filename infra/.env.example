# FitAgent 环境变量样例。复制为 .env 后填本机/服务器真实值。
# .env 已在 .gitignore 中，禁止提交；不要把真实 AppSecret 写进任何会进 Git 的文件。

# ---- MySQL 8.4（你的服务器或本地 Compose）----
# 服务器路线：把 host/port 指过去即可，代码不需要改动
FITAGENT_MYSQL_URL="jdbc:mysql://127.0.0.1:13306/smart_health_training?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&characterEncoding=utf8&serverTimezone=UTC"
FITAGENT_MYSQL_USERNAME=fitagent
FITAGENT_MYSQL_PASSWORD=
FITAGENT_DB_POOL_MAX=10

# 结构与 Flyway 历史由应用管理时保持 true。
# 如果你已手工执行 docs/sql/p1-init-mysql-8.4.sql 建好 8 张表，就设为 false，
# 两条路线只能选一条，否则 Flyway 会因为对象已存在而失败。
FITAGENT_FLYWAY_ENABLED=true

# ---- Redis ----
FITAGENT_REDIS_HOST=127.0.0.1
FITAGENT_REDIS_PORT=16379
FITAGENT_REDIS_PASSWORD=
FITAGENT_REDIS_DATABASE=0

# ---- 微信小程序（AppSecret 只存在于后端，绝不出现在小程序端）----
FITAGENT_WECHAT_APPID=
FITAGENT_WECHAT_SECRET=

# ---- 应用 ----
FITAGENT_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- 仅使用 infra/docker-compose.yml 时才需要 ----
FITAGENT_MYSQL_ROOT_PASSWORD=
FITAGENT_MYSQL_HOST_PORT=13306
FITAGENT_REDIS_HOST_PORT=16379

# ---- 前端（miniapp/.env.development 里用的是 VITE_ 前缀）----
VITE_API_BASE_URL=http://127.0.0.1:8080

# ---- Agent 第一版：BYOK 加密与供应商接入 ----
# 两个必须不同的秘密：master 用来 AES-256-GCM 加密用户的 API Key，
# fingerprint 用来判"是不是同一把 Key"（HMAC）。都是 base64 的 32 字节：
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 留空 = 没配置：保存 Key 的接口会直接报配置错误，不会退化成默认密钥。
FITAGENT_MASTER_KEY=
FITAGENT_KEY_FINGERPRINT_KEY=
FITAGENT_KEY_VERSION=v1

# DeepSeek 地址。最终权威值是 model_provider.base_url（表里由运维写入，
# 接口不接受客户端改写）；文档路径不带 /v1。
FITAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地演示消息循环用的假模型开关。prod/production 下一旦为 true，
# FakeModelStartupGuard 会让应用直接启动失败。
FITAGENT_AGENT_FAKE_MODEL_ENABLED=false

# 用户的 API Key 由小程序在"我的 → 模型设置"里自己提交，**不经过环境变量**：
# 本项目是 BYOK，模型费记在用户自己的供应商账户上，后端只保存密文。
